ENVIRONMENT=development
# Replace/add the exact deployed wedding-site origin before production deployment.
# Example: CORS_ORIGINS=["https://your-wedding-site.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_GUEST_COUNT=10
# Optional ISO 8601 UTC timestamp, for example: 2026-12-31T18:30:00Z
RSVP_DEADLINE=
# Use no-store when invitation revocations must take effect immediately.
INVITATION_CACHE_CONTROL=no-store
SPREADSHEET_ID=1TIWC3WabU40iqj-NtxEVbXNNT_-wD3Rh4f2rWuZO66I
WORKSHEET_NAME=RSVP
# Use one credential source. Never commit the JSON or its file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
